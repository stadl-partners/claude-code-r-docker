#!/usr/bin/env bash
set -euo pipefail

umask 077

if [[ "$(id -u)" == "0" ]]; then
  echo "ERROR: refusing to run Claude Code as root." >&2
  exit 77
fi

cd /workspace

if [[ ! -r /workspace ]]; then
  echo "ERROR: /workspace is not readable by uid $(id -u)." >&2
  exit 74
fi

if [[ ! -w /workspace ]]; then
  echo "ERROR: /workspace is not writable by uid $(id -u)." >&2
  echo "Rebuild so the image user matches your host user (claude-r does this with HOST_UID/HOST_GID); do not run the container as root." >&2
  exit 73
fi

mkdir -p "${R_LIBS_USER:?}" "${R_USER_CACHE_DIR:?}" "${RENV_PATHS_CACHE:?}"

exec /usr/local/bin/claude "$@"
