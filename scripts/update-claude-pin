#!/usr/bin/env bash
# Usage: scripts/update-claude-pin [VERSION|stable|latest]   (default: stable)
# Rewrites CLAUDE_CODE_VERSION and the per-arch sha256 ARGs in the Dockerfile from the release
# manifest. Review the diff (and the release notes) before committing.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
BASE="https://downloads.claude.ai/claude-code-releases"
target="${1:-stable}"

if [[ "$target" =~ ^(stable|latest)$ ]]; then
  version="$(curl -fsSL "$BASE/$target")"
else
  version="$target"
fi
[[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "bad version: $version" >&2; exit 1; }

manifest="$(curl -fsSL "$BASE/$version/manifest.json" | tr -d '\n\r ')"

checksum() { # $1 = platform name, e.g. linux-x64 (glibc build, not -musl)
  if [[ "$manifest" =~ \"$1\":\{[^{}]*\"checksum\":\"([a-f0-9]{64})\" ]]; then
    echo "${BASH_REMATCH[1]}"
  else
    echo "platform $1 not found in manifest for $version" >&2; return 1
  fi
}

amd64="$(checksum linux-x64)"
arm64="$(checksum linux-arm64)"

sed -i \
  -e "s/^ARG CLAUDE_CODE_VERSION=.*/ARG CLAUDE_CODE_VERSION=$version/" \
  -e "s/^ARG CLAUDE_SHA256_AMD64=.*/ARG CLAUDE_SHA256_AMD64=$amd64/" \
  -e "s/^ARG CLAUDE_SHA256_ARM64=.*/ARG CLAUDE_SHA256_ARM64=$arm64/" \
  "$ROOT/Dockerfile"

echo "Dockerfile pinned to Claude Code $version"
echo "  linux-x64   $amd64"
echo "  linux-arm64 $arm64"
